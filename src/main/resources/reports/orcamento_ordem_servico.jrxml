<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="orcamento_ordem_servico"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="32"
              bottomMargin="32"
              uuid="f6f84244-b342-4c41-87ac-95a41d42c0b8">

    <property name="net.sf.jasperreports.default.pdf.encoding" value="Cp1252"/>
    <property name="net.sf.jasperreports.default.pdf.embedded" value="false"/>

    <style name="Base" fontName="SansSerif" fontSize="9" pdfFontName="Helvetica"/>
    <style name="Title" style="Base" fontSize="18" isBold="true"/>
    <style name="Subtitle" style="Base" fontSize="11" isBold="true"/>
    <style name="Label" style="Base" isBold="true"/>
    <style name="TableHeader" style="Base" mode="Opaque" backcolor="#EDEDED" isBold="true">
        <box>
            <pen lineWidth="0.5" lineColor="#BBBBBB"/>
        </box>
    </style>
    <style name="TableCell" style="Base">
        <box>
            <pen lineWidth="0.25" lineColor="#DDDDDD"/>
        </box>
    </style>

    <parameter name="LOGO" class="java.io.InputStream"/>
    <parameter name="ORDEM_SERVICO_ID" class="java.lang.String"/>
    <parameter name="STATUS" class="java.lang.String"/>
    <parameter name="DATA_CRIACAO" class="java.lang.String"/>
    <parameter name="TEMPO_PREVISTO_EXECUCAO" class="java.lang.String"/>
    <parameter name="CLIENTE_NOME" class="java.lang.String"/>
    <parameter name="CLIENTE_DOCUMENTO" class="java.lang.String"/>
    <parameter name="CLIENTE_EMAIL" class="java.lang.String"/>
    <parameter name="CLIENTE_TELEFONE" class="java.lang.String"/>
    <parameter name="REPRESENTANTE_NOME" class="java.lang.String"/>
    <parameter name="VEICULO_PLACA" class="java.lang.String"/>
    <parameter name="VEICULO_MARCA" class="java.lang.String"/>
    <parameter name="VEICULO_MODELO" class="java.lang.String"/>
    <parameter name="VEICULO_ANO" class="java.lang.String"/>
    <parameter name="VEICULO_COR" class="java.lang.String"/>
    <parameter name="VEICULO_KM" class="java.lang.String"/>
    <parameter name="VALOR_TOTAL" class="java.math.BigDecimal"/>

    <field name="tipo" class="java.lang.String"/>
    <field name="descricao" class="java.lang.String"/>
    <field name="pecaCodigo" class="java.lang.String"/>
    <field name="quantidade" class="java.lang.Integer"/>
    <field name="valorUnitario" class="java.math.BigDecimal"/>
    <field name="valorTotal" class="java.math.BigDecimal"/>

    <title>
        <band height="178">
            <image>
                <reportElement x="0" y="0" width="54" height="54"/>
                <imageExpression class="java.io.InputStream"><![CDATA[$P{LOGO}]]></imageExpression>
            </image>
            <staticText>
                <reportElement style="Title" x="140" y="14" width="235" height="26"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Auto Service]]></text>
            </staticText>
            <textField>
                <reportElement style="Base" x="395" y="4" width="120" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$P{DATA_CRIACAO}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="66" width="515" height="1"/>
            </line>
            <textField>
                <reportElement style="Label" x="0" y="78" width="260" height="16"/>
                <textFieldExpression><![CDATA["Ordem de Servico: " + $P{ORDEM_SERVICO_ID}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Label" x="300" y="78" width="215" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Status: " + $P{STATUS}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Base" x="0" y="96" width="515" height="14"/>
                <textFieldExpression><![CDATA["Tempo previsto de execucao: " + $P{TEMPO_PREVISTO_EXECUCAO}]]></textFieldExpression>
            </textField>

            <rectangle>
                <reportElement x="0" y="112" width="248" height="56"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Subtitle" x="10" y="120" width="120" height="16"/>
                <text><![CDATA[Cliente]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="10" y="140" width="228" height="14"/>
                <textFieldExpression><![CDATA[$P{CLIENTE_NOME}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Base" x="10" y="154" width="228" height="14"/>
                <textFieldExpression><![CDATA[$P{CLIENTE_DOCUMENTO}]]></textFieldExpression>
            </textField>

            <rectangle>
                <reportElement x="267" y="112" width="248" height="56"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#CCCCCC"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement style="Subtitle" x="277" y="120" width="120" height="16"/>
                <text><![CDATA[Veiculo]]></text>
            </staticText>
            <textField>
                <reportElement style="Base" x="277" y="140" width="228" height="14"/>
                <textFieldExpression><![CDATA[$P{VEICULO_PLACA} + " - " + $P{VEICULO_MARCA} + " " + $P{VEICULO_MODELO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Base" x="277" y="154" width="228" height="14"/>
                <textFieldExpression><![CDATA["Ano " + $P{VEICULO_ANO} + " | Cor " + $P{VEICULO_COR}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement style="TableHeader" x="0" y="0" width="58" height="24"/>
                <text><![CDATA[Tipo]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="58" y="0" width="222" height="24"/>
                <text><![CDATA[Descricao]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="280" y="0" width="70" height="24"/>
                <text><![CDATA[Peca]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="350" y="0" width="45" height="24"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Qtd]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="395" y="0" width="60" height="24"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Unit.]]></text>
            </staticText>
            <staticText>
                <reportElement style="TableHeader" x="455" y="0" width="60" height="24"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Total]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22">
            <textField>
                <reportElement style="TableCell" x="0" y="0" width="58" height="22"/>
                <textFieldExpression><![CDATA[$F{tipo}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement style="TableCell" x="58" y="0" width="222" height="22"/>
                <textFieldExpression><![CDATA[$F{descricao}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="TableCell" x="280" y="0" width="70" height="22"/>
                <textFieldExpression><![CDATA[$F{pecaCodigo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="TableCell" x="350" y="0" width="45" height="22"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{quantidade}]]></textFieldExpression>
            </textField>
            <textField pattern="R$ #,##0.00">
                <reportElement style="TableCell" x="395" y="0" width="60" height="22"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{valorUnitario}]]></textFieldExpression>
            </textField>
            <textField pattern="R$ #,##0.00">
                <reportElement style="TableCell" x="455" y="0" width="60" height="22"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{valorTotal}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement style="Base" x="0" y="2" width="250" height="14" forecolor="#777777"/>
                <textFieldExpression><![CDATA["AutoService - Orcamento gerado automaticamente"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Base" x="430" y="2" width="85" height="14" forecolor="#777777"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Pagina " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="58">
            <line>
                <reportElement x="0" y="10" width="515" height="1"/>
            </line>
            <staticText>
                <reportElement style="Subtitle" x="330" y="24" width="80" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Total]]></text>
            </staticText>
            <textField pattern="R$ #,##0.00">
                <reportElement style="Title" x="415" y="20" width="100" height="28"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$P{VALOR_TOTAL}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
