# Compose: Mailpit em :1025 (UI http://localhost:8025). Com docker compose, a app usa MAIL_HOST=mailpit.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=orcamentos@autoservice.local
# Mesmo secret da API e do serviço auth externo (iss=autoservice-auth / autoservice-admin)
AUTOSERVICE_JWT_SECRET=replace-with-a-strong-random-secret
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=replace-with-your-sonarqube-token
SONAR_DB_PASSWORD=replace-with-a-local-sonar-db-password
